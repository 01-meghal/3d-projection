# Server
PORT=4000

# Allowed frontend origin (CORS)
CLIENT_ORIGIN=http://localhost:5173

# MongoDB connection
MONGODB_URI=mongodb://127.0.0.1:27017/ar_platform

# Public base URL for served assets (mock S3 "ar-web-assets" bucket).
# Used to build absolute model URLs returned to the client.
PUBLIC_ASSET_BASE_URL=http://localhost:4000/assets

# Base URL the mock AI engine uses to call the completion webhook back into this server.
SELF_BASE_URL=http://localhost:4000

# Mock AI photogrammetry engine
AI_MOCK_DELAY_MS=8000
# Set to a value between 0 and 1 to randomly fail jobs (exercises the FAILED path). 0 = never fail.
AI_MOCK_FAILURE_RATE=0

# Photogrammetry provider: 'mock' (default) or 'kiri' (real KIRI Engine API).
# If set to 'kiri' but KIRI_API_KEY is empty, it falls back to mock.
PHOTOGRAMMETRY_PROVIDER=mock

# --- KIRI Engine (only used when PHOTOGRAMMETRY_PROVIDER=kiri) ---
# Get a key from a KIRI Engine Developer account: https://docs.kiriengine.app
KIRI_API_KEY=
KIRI_BASE_URL=https://api.kiriengine.app/api
KIRI_FILE_FORMAT=glb
KIRI_MODEL_QUALITY=1      # 0 High, 1 Medium, 2 Low, 3 Ultra
KIRI_TEXTURE_QUALITY=1    # 0 4K, 1 2K, 2 1K, 3 8K
KIRI_POLL_INTERVAL_MS=15000
KIRI_MAX_POLL_MS=1200000  # 20 minutes
